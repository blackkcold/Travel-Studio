{
  "name": "travel-studio",
  "version": "1.0.0",
  "description": "Local-first travel maps and art keepsakes",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/serve.mjs",
    "check": "tsc -b && node scripts/check-boundaries.mjs",
    "test:e2e": "playwright test",
    "test:providers": "node scripts/provider-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackkcold/Travel-Studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/blackkcold/Travel-Studio/issues"
  },
  "homepage": "https://github.com/blackkcold/Travel-Studio#readme",
  "private": "true",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "konva": "10.9.1",
    "lucide-react": "1.72.0",
    "maplibre-gl": "6.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
